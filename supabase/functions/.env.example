# Stripe Edge Functions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio Proxy Edge Function
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_SERVICE_SID=

# Supabase Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Didit — valores del proyecto/destination webhook en Didit Console.
# DIDIT_CALLBACK_URL es el webhook server-to-server donde Didit publica el
# resultado (NO la página /verificacion del frontend: esa no procesa POST y la
# verificación quedaría en pendiente para siempre).
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://tu-proyecto.supabase.co/functions/v1/webhook-didit

# URL publica de app-conductor usada para onboarding externo
RUUM_APP_CONDUCTOR_URL=

# Sprint C4 — Firebase Cloud Messaging HTTP v1
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
