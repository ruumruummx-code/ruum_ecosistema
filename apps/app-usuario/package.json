{
  "name": "@ruum/app-usuario",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:lighthouse": "lhci autorun",
    "predev": "node ../../scripts/validate-env.mjs app-usuario",
    "prebuild": "node ../../scripts/validate-env.mjs app-usuario && node scripts/assert-csp.mjs",
    "validate:env": "node ../../scripts/validate-env.mjs app-usuario",
    "assert:csp": "node scripts/assert-csp.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.0",
    "@ruum/api": "workspace:*",
    "@ruum/shared": "workspace:*",
    "@ruum/ui": "workspace:*",
    "@sentry/nextjs": "^10.70.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.47.0",
    "@upstash/redis": "^1.38.3",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/eslintrc": "^3.3.6",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.23",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "3.2.6"
  }
}
