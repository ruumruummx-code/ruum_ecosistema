# ─────────────────────────────────────────────────────────────
# Supabase (público, se expone al bundle — la anon key está protegida por RLS)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Variables server-side equivalentes usadas por /auth/callback como fallback.
# SeRecommendan en despliegue para que la rotación de la pública no rompa el flujo.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Entorno de la app — ARQ-5 (auditoría fase 4)
# Sin esta variable, staging se comporta como producción y emite una CSP
# bloqueante en vez de Report-Only. Valores: production | staging | development
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RUUM_AMBIENTE=

# ─────────────────────────────────────────────────────────────
# Stripe — Pago de traslados
# ─────────────────────────────────────────────────────────────
# Clave pública (se expone al bundle — es segura por diseño)
# Obtener en: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
## Checkout masivo: configurar también en el servidor Next (nunca NEXT_PUBLIC_).
STRIPE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Mapbox — la clave secreta se usa solo en el servidor
# ─────────────────────────────────────────────────────────────
MAPBOX_SECRET_TOKEN=

# ── Variables SOLO para Supabase Edge Functions (NO poner aquí) ──
# Configurar en: Supabase Dashboard → Edge Functions → Secrets
#   STRIPE_WEBHOOK_SECRET=whsec_...      (firma del webhook)
#
# O vía CLI:
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────
# Sentry — si faltan, el build pasa igual y la observabilidad se degrada
# en silencio. Ver scripts/validate-env.mjs.
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ALERTS_ENABLED=true
NEXT_PUBLIC_APP_VERSION=

# ─────────────────────────────────────────────────────────────
# Mapbox — clave pública en el cliente y clave secreta solo en el servidor.
# El style URL se resuelve con el valor por defecto de la librería.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
# Esquema/origen del build nativo de Capacitor (opcional)
RUUM_CAPACITOR_SERVER_URL=

# ─────────────────────────────────────────────────────────────
# CSP Report-Only — solo lectura; con true en staging la CSP se reporta sin
# bloquear (migración progresiva).
# ─────────────────────────────────────────────────────────────
# CSP_REPORT_ONLY=
# NEXT_PUBLIC_CSP_REPORT_ONLY=

# ─────────────────────────────────────────────────────────────
# Rate-limit distribuido para /api/csp-report y /api/auth/*
# OBLIGATORIO en producción: sin Redis el límite degrada a memoria por
# instancia (cada instancia cuenta por separado; ante abuso distribuido
# es más débil). Con Redis el límite es global y real.
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternativa para Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Twilio Verify v2 — Verificación telefónica por SMS en registro
# En dev/test sin estas variables, el sistema opera con mock (código: 123456)
# En builds alojados, PHONE_VERIFY_SECRET es obligatorio y debe tener al menos
# 32 caracteres. Configurarlo como variable privada (sin NEXT_PUBLIC_).
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFY_SECRET=
#
# Bypass TEMPORAL del OTP solo para desarrollo local (NUNCA en Vercel/prod):
# salta el modal SMS en /registro y el signup acepta sin token.
# Doble candado: el servidor lo ignora si NODE_ENV=production.
# PHONE_VERIFY_BYPASS=true            → servidor (route signup)
# NEXT_PUBLIC_PHONE_VERIFY_BYPASS=true → UI de /registro

# Opcional para invocaciones manuales de los endpoints internos de Next.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# NO declarar aquí, y nunca con prefijo NEXT_PUBLIC_:
#   DIDIT_API_KEY / DIDIT_WEBHOOK_SECRET  → solo Edge Functions de Supabase
#   RESEND_API_KEY                        → pertenece a panel-admin
#   TWILIO_PROXY_SERVICE_SID              → solo secret de la Edge Function
# ─────────────────────────────────────────────────────────────
# Suspensión temporal explícita, también en producción (activa por defecto).
# Para reactivar SMS: false en ambas y redesplegar. No acredita teléfonos nuevos.
PHONE_VERIFICATION_SUSPENDED=true
NEXT_PUBLIC_PHONE_VERIFICATION_SUSPENDED=true
