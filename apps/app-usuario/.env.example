# ─────────────────────────────────────────────────────────────
# Supabase (público, se expone al bundle — la anon key está protegida por RLS)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Variables server-side equivalentes usadas por /auth/callback como fallback.
# SeRecommendan en despliegue para que la rotación de la pública no rompa el flujo.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Entorno de la app — ARQ-5 (auditoría fase 4)
# Sin esta variable, staging se comporta como producción y emite una CSP
# bloqueante en vez de Report-Only. Valores: production | staging | development
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RUUM_AMBIENTE=

# ─────────────────────────────────────────────────────────────
# Stripe — Pago de traslados
# ─────────────────────────────────────────────────────────────
# Clave pública (se expone al bundle — es segura por diseño)
# Obtener en: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Variables SOLO para Supabase Edge Functions (NO poner aquí) ──
# Configurar en: Supabase Dashboard → Edge Functions → Secrets
#   STRIPE_SECRET_KEY=sk_test_...        (clave secreta de Stripe)
#   STRIPE_WEBHOOK_SECRET=whsec_...      (firma del webhook)
#   SUPABASE_SERVICE_ROLE_KEY=...        (service role key)
#
# O vía CLI:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────
# Sentry — si faltan, el build pasa igual y la observabilidad se degrada
# en silencio. Ver scripts/validate-env.mjs.
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_APP_VERSION=

# ─────────────────────────────────────────────────────────────
# Mapbox — solo se usa NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN; el style URL se
# resuelve con el valor por defecto de la librería.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
# Esquema/origen del build nativo de Capacitor (opcional)
RUUM_CAPACITOR_SERVER_URL=

# ─────────────────────────────────────────────────────────────
# CSP Report-Only — solo lectura; con true en staging la CSP se reporta sin
# bloquear (migración progresiva).
# ─────────────────────────────────────────────────────────────
# CSP_REPORT_ONLY=
# NEXT_PUBLIC_CSP_REPORT_ONLY=

# ─────────────────────────────────────────────────────────────
# Rate-limit distribuido para /api/csp-report y /api/auth/*
# Sin esto los endpoints usan memoria local (no distribuido: solo dev/test)
# ─────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# NO declarar aquí, y nunca con prefijo NEXT_PUBLIC_:
#   DIDIT_API_KEY / DIDIT_WEBHOOK_SECRET  → solo Edge Functions de Supabase
#   SUPABASE_SERVICE_ROLE_KEY             → nunca en el cliente; bypasea RLS
#   RESEND_API_KEY                        → pertenece a panel-admin
# ─────────────────────────────────────────────────────────────