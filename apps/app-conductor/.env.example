# Supabase publico para Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base de la aplicación (usado para emails de confirmación y recuperación)
NEXT_PUBLIC_APP_URL=

# Version visible en telemetria/eventos de registro
NEXT_PUBLIC_APP_VERSION=

# Capacitor opcional para builds que apuntan a otro ambiente
RUUM_CAPACITOR_SERVER_URL=

# Mapbox: mapa estático de ruta hacia el punto de inicio (pantalla "Dirígete
# al punto de inicio"). Mismo token público (pk.) usado en panel-admin y
# app-usuario -- si no está configurado, la pantalla muestra solo la
# dirección en texto, sin mapa.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_URL=
# Contactos publicos de soporte.
# Produccion debe usar los canales oficiales. Staging/desarrollo deben usar
# valores de prueba y se mostraran marcados como "(pruebas)".
NEXT_PUBLIC_RUUM_AMBIENTE=staging
NEXT_PUBLIC_RUUM_SOPORTE_TELEFONO=5500000000
NEXT_PUBLIC_RUUM_SOPORTE_CORREO=soporte-conductores-pruebas@example.test
NEXT_PUBLIC_RUUM_EMERGENCIA_TELEFONO=5500000911

# Resend
RESEND_API_KEY=

# Upstash Redis / Vercel KV — rate-limit distribuido multi-instancia
# Obligatorio en producción para rate-limit global en recovery y csp-report
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternativa:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Didit se configura como secreto de las Edge Functions de Supabase
# (Dashboard de Supabase > Edge Functions > Secrets).
# Nunca expongas DIDIT_API_KEY ni DIDIT_WEBHOOK_SECRET como NEXT_PUBLIC_*.
# Nota: DIDIT_API_KEY y DIDIT_CALLBACK_URL también son secrets de Edge Functions,
# NO se configuran en el .env del frontend.
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# CSP — flag estricto para style-src sin unsafe-inline (SEC-003, 2026-11-01)
# En staging: CSP_STRICT_STYLES=true para validar 7d report-only
# CSP_STRICT_STYLES=true

# Secreto HMAC (mín 32 chars) para firmar la cookie httpOnly que cachea el rol
# de la app en el middleware (packages/shared/src/seguridad/cookie-rol.ts).
# Sin este secreto el middleware sigue funcionando: consulta el rol en cada
# petición protegida (fail-open) y emite la métrica
# `conductor_role_verification_failed` cuando la verificación falla.
RUUM_ROLE_COOKIE_SECRET=

# ========== Configuración de Pruebas E2E (Playwright) ==========
# Credenciales del conductor E2E que será creado/actualizado en Supabase
# Usar un email de prueba que no sea usuario real
PLAYWRIGHT_E2E_CONDUCTOR_EMAIL=conductor-e2e@ruumruum.test
PLAYWRIGHT_E2E_CONDUCTOR_PASSWORD=

# URL y clave de Supabase para preparar fixtures de E2E
# Requiere acceso de admin/service-role para crear usuarios y datos
PLAYWRIGHT_SUPABASE_URL=
PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=

# Opcional: URL base de la aplicación para tests (default: http://localhost:3001)
# PLAYWRIGHT_BASE_URL=http://localhost:3001

# Opcional: Email y contraseña del usuario propietario del vehículo en E2E
# (default: usuario-e2e-conductor@ruumruum.test)
# PLAYWRIGHT_E2E_OWNER_EMAIL=
# PLAYWRIGHT_E2E_OWNER_PASSWORD=

# Opcional: Desactivar artifacts (screenshots/videos) de auth para acelerar tests
# PLAYWRIGHT_DISABLE_AUTH_ARTIFACTS=1
