{
  "$schema": "https://turborepo.dev",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "VERCEL*",
        "CI",
        "NEXT_PUBLIC_*",
        "SENTRY_*",
        "CSP_STRICT_STYLES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:a11y": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
