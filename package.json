{
  "name": "ruum-ruum",
  "private": true,
  "scripts": {
    "prepare": "node scripts/prepare-husky.mjs",
    "dev": "turbo run dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=./packages/*",
    "cp:generar": "node packages/shared/scripts/generar-codigos-postales-mx.mjs cp_mexico_full.json apps/app-usuario/public/data/codigos-postales apps/panel-admin/public/data/codigos-postales",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/supabase.ts",
    "typecheck:android": "pnpm -r run typecheck",
    "test:unit:android": "pnpm --filter \"./packages/*\" run test",
    "ci:clean": "node scripts/verify-clean-ci.mjs",
    "validate:env": "node scripts/validate-env.mjs workspace",
    "test:p0": "node --test apps/panel-admin/test/*.test.mjs",
    "test:p1": "node --test apps/panel-admin/test/p1-estabilizacion.test.mjs",
    "test:p2": "node --test apps/panel-admin/test/p2-madurez.test.mjs",
    "test:load": "k6 run tests/load/panel-admin-degradacion.js",
    "test:load:report": "k6 run tests/load/panel-admin-degradacion.js --out json=tests/load/results/resultados.json",
    "test:load:usuario": "k6 run tests/load/app-usuario-flujos-criticos.js",
    "test:load:usuario:artillery": "artillery run tests/load/app-usuario-artillery.yml",
    "test:a11y:real": "playwright test apps/panel-admin/tests/a11y-real",
    "test:a11y:real:all": "playwright test apps/panel-admin/tests/a11y-real --reporter=html",
    "test:e2e:real": "playwright test apps/panel-admin/tests/e2e --reporter=html",
    "test:e2e:usuario": "pnpm --filter @ruum/app-usuario test:e2e",
    "test:sql": "supabase test db test",
    "test:e2e:golden": "node tests/e2e/run-golden.mjs",
    "test:piramide": "pnpm test:unit && pnpm test:sql && pnpm test:e2e:golden",
    "check:fronteras": "node scripts/check-fronteras.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:sql:rls": "supabase test db test/rt42_rls_admin_roles.test.sql",
    "test:sql:concurrencia": "supabase test db test/rt43_concurrencia_operadores.test.sql",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:deps": "pnpm audit --audit-level=high",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "check:supabase-drift": "node scripts/check-supabase-drift.mjs",
    "check:rpc-casts": "node scripts/check-rpc-casts.mjs",
    "test:security": "node --test tests/security/scan-secrets.test.mjs",
    "test:release": "node --test tests/release/changelog.test.mjs",
    "changelog": "node scripts/changelog.mjs",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.14.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@types/node": "^22.20.5",
    "@vitest/ui": "3.2.6",
    "dotenv": "^16.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "postcss": "8.5.26",
      "nanoid@3": "3.3.18",
      "fast-uri": "3.1.7",
      "sharp": "0.35.5",
      "proxy-addr": "2.0.8",
      "tinypool": "2.1.2",
      "webpack-dev-middleware": "7.4.6",
      "undici": ">=8.12.2",
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
      "basic-ftp": "6.2.1",
      "compression": "1.8.2",
      "source-map-js": "1.2.2",
      "tar": "7.5.21",
      "js-yaml": "4.3.2",
      "adm-zip": "0.6.1",
      "image-size": "2.0.3",
      "tmp": "0.2.7",
      "vite": "6.4.5",
      "storybook": "10.6.3",
      "ip-address": "10.3.1",
      "browserslist": "4.28.7",
      "@xmldom/xmldom": "0.9.12",
      "body-parser": ">=1.20.9"
    }
  },
  "dependencies": {
    "mapbox-gl": "^3.33.0",
    "react-map-gl": "^8.1.3"
  }
}
