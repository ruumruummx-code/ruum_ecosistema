{
  "name": "ruum-ruum",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:android": "pnpm -r run typecheck",
    
    "// --- PIPELINES DE TURBO (Delegan a cada app/package) ---": "",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    
    "// --- COMANDOS CENTRALIZADOS DE BASE DE DATOS (SUPABASE) ---": "",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/supabase.ts",
    "test:sql": "supabase test db test",
    "test:sql:rls": "supabase test db test/rt42_rls_admin_roles.test.sql",
    "test:sql:concurrencia": "supabase test db test/rt43_concurrencia_operadores.test.sql",

    "// --- PRUEBAS DE CARGA Y PERFORMANCE (K6 / ARTILLERY) ---": "",
    "test:load": "k6 run tests/load/panel-admin-degradacion.js",
    "test:load:report": "k6 run tests/load/panel-admin-degradacion.js --out json=tests/load/results/resultados.json",
    "test:load:usuario": "k6 run tests/load/app-usuario-flujos-criticos.js",
    "test:load:usuario:artillery": "artillery run tests/load/app-usuario-artillery.yml",

    "// --- SCRIPTS DE CONTROL DE CALIDAD, SEGURIDAD Y DEPLOY ---": "",
    "cp:generar": "node packages/shared/scripts/generar-codigos-postales-mx.mjs cp_mexico_full.json apps/app-usuario/public/data/codigos-postales apps/panel-admin/public/data/codigos-postales",
    "ci:clean": "node scripts/verify-clean-ci.mjs",
    "validate:env": "node scripts/validate-env.mjs workspace",
    "check:fronteras": "node scripts/check-fronteras.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:deps": "pnpm audit --audit-level=high",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "check:supabase-drift": "node scripts/check-supabase-drift.mjs",
    "check:rpc-casts": "node scripts/check-rpc-casts.mjs",
    "changelog": "node scripts/changelog.mjs",
    
    "// --- INTERFAZ GRÁFICA DE VITEST ---": "",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/ui": "3.2.6",
    "dotenv": "^16.6.1",
    "husky": "^9.1.7",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "postcss": "8.5.26",
      "nanoid@3": "3.3.18",
      "fast-uri": "3.1.7",
      "sharp": "0.35.5",
      "proxy-addr": "2.0.8",
      "tinypool": "2.1.2",
      "webpack-dev-middleware": "7.4.6",
      "undici": ">=8.12.2",
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
      "basic-ftp": "6.2.1",
      "compression": "1.8.2",
      "source-map-js": "1.2.2",
      "tar": "7.5.21",
      "js-yaml": "4.3.2",
      "adm-zip": "0.6.1",
      "image-size": "2.0.3",
      "tmp": "0.2.7",
      "vite": "6.4.5",
      "storybook": "10.6.3",
      "ip-address": "10.3.1",
      "browserslist": "4.28.7",
      "@xmldom/xmldom": "0.9.12",
      "body-parser": ">=1.20.9",
      "zod": "4.6.6"
    }
  },
  "dependencies": {
    "mapbox-gl": "^3.33.0",
    "react-map-gl": "^8.1.3"
  }
}
