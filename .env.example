# Ruum Monorepo Environment Variables
# Copy this file to .env and fill in the required values

# ============================================================================
# Common Variables
# ============================================================================

# Node environment
NODE_ENV=development

# ============================================================================
# Supabase Configuration
# ============================================================================

# Supabase URL (local or remote)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Supabase anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# ============================================================================
# Application URLs
# ============================================================================

# Canonical app URL — exigida por scripts/validate-env.mjs (app-conductor).
# En local: la URL de la app que estés levantando.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# App version (SemVer) — exigida por validate-env; si se omite, se lee de
# config/app-version.json. En producción no puede ser 0.0.1/ci.
NEXT_PUBLIC_APP_VERSION=1.0.0

# App Conductor
NEXT_PUBLIC_APP_CONDUCTOR_URL=http://localhost:3001

# App Usuario  
NEXT_PUBLIC_APP_USUARIO_URL=http://localhost:3000

# Panel Admin
NEXT_PUBLIC_PANEL_ADMIN_URL=http://localhost:3002

# ============================================================================
# API Configuration
# ============================================================================

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ============================================================================
# Capacitor / Mobile Configuration
# ============================================================================

# App ID for mobile
CAPACITOR_APP_ID=com.ruum.app

# ============================================================================
# Stripe Configuration (for app-usuario)
# ============================================================================

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Stripe secret key (server-side only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# ============================================================================
# Mapbox Configuration (for panel-admin)
# ============================================================================

# Mapbox access token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# ============================================================================
# Security Configuration
# ============================================================================

# Session secret
SESSION_SECRET=your-session-secret-key-here

# JWT secret
JWT_SECRET=your-jwt-secret-key-here

# ============================================================================
# Database Configuration (for server-side)
# ============================================================================

# PostgreSQL connection string
# solo desarrollo local, nunca producción. Nunca pongas contraseñas reales
# en archivos versionados: usa variables de entorno o un gestor de secretos.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

# ============================================================================
# Docker Configuration
# ============================================================================

# Docker container ports
APP_CONDUCTOR_PORT=3001
APP_USUARIO_PORT=3000
PANEL_ADMIN_PORT=3002

# Didit — secretos para las Edge Functions de Supabase, nunca NEXT_PUBLIC_*.
# DIDIT_CALLBACK_URL es el webhook server-to-server donde Didit publica el
# resultado (NO la página /verificacion del frontend: esa no procesa POST y la
# verificación quedaría en pendiente para siempre).
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://asmzetwwwugaoowiukdv.supabase.co/functions/v1/webhook-didit

# Twilio Verify — OTP por SMS en app-usuario (registro).
# Nombres exactos que lee apps/app-usuario/src/lib/phone-verification.ts.
# Sin estas tres, Verify opera en MOCK (123456) fuera de producción y
# falla cerrado en producción. No renombrar sin actualizar ese módulo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Secreto HMAC (mín 32 chars) para firmar el token de teléfono verificado.
PHONE_VERIFY_SECRET=
# Secreto HMAC (mín 32 chars) para firmar la cookie httpOnly que cachea el rol
# de la app en el middleware de app-conductor (packages/shared/src/seguridad/cookie-rol.ts).
# Opcional: sin él el middleware consulta el rol en cada petición protegida.
RUUM_ROLE_COOKIE_SECRET=
# Twilio Proxy — llamadas enmascaradas vía Edge Function
# crear-llamada-enmascarada (secrets en Dashboard → Edge Functions).
# TWILIO_ACCOUNT_SID y TWILIO_AUTH_TOKEN se reutilizan aquí.
# TWILIO_PROXY_SERVICE_SID se configura como secret de la Edge Function,
# no en el .env de las apps Next.js.

# ============================================================================
# Upstash Redis / KV (Rate Limiting Distribuido)
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=